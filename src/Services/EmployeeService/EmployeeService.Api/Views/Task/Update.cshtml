@using EmployeeService.Core.Enums
@model TaskUpdateViewModel

@{
    ViewData["Title"] = "Update task";
}

<h2>Update employee</h2>

<form asp-action="Update" asp-route-id="@Model.Id" method="post"
      enctype="multipart/form-data" class="form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <input type="hidden" asp-for="Id" />

    <div class="form-row">
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="6" class="form-textarea"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="TaskState"></label>
        <select asp-for="TaskState">
            <option value="">— Select state —</option>
            @foreach (var state in Enum.GetValues<TaskState>())
            {
                if (state != TaskState.Unspecified)
                {
                    <option value="@state">@state</option>
                }
            }
        </select>
        <span asp-validation-for="TaskState" class="field-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update</button>
        <a class="btn" asp-action="Index">Cancel</a>
    </div>
</form>